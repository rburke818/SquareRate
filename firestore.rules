rules_version = '2';

// SquareRate strict per-user security rules.
//
// A user can only read, create, update, or delete documents whose `userId`
// field matches their authenticated UID. The `users/{uid}` profile document
// is keyed by the UID itself.
//
// IMPORTANT: everything that decides what a customer is entitled to —
// their plan, their scan counters, their LemonSqueezy identifiers — is
// writable ONLY by the Admin SDK (the n8n workflows), which bypasses these
// rules entirely. The browser must never be able to touch those fields: the
// Firestore client is fully scriptable from the console, so any field a
// signed-in user can write is a field they can award themselves.
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------
    // Reusable helpers
    // -------------------------------------------------------------------

    // True when the caller is authenticated AND is the owner of the
    // document already on disk (i.e. `resource.data.userId` exists).
    function isExistingOwner() {
      return request.auth != null
             && resource != null
             && resource.data.userId == request.auth.uid;
    }

    // True when the incoming write stamps the caller's UID on the doc.
    function writesAsOwner() {
      return request.auth != null
             && request.resource.data.userId == request.auth.uid;
    }

    // -------------------------------------------------------------------
    // User profile documents. Doc ID must equal the authenticated user's UID.
    // -------------------------------------------------------------------
    match /users/{userId} {

      // Entitlement and billing state. Server-owned: n8n writes these via the
      // Admin SDK after metering a scan or processing a LemonSqueezy webhook.
      // `referred_by` is included because commission is paid against it, so a
      // user must not be able to re-point their own referral after signup.
      function serverOwnedFields() {
        return [
          'plan',
          'tier',
          'api_queries_this_month',
          'usage_period',
          'trial_scans_used',
          'ls_subscription_id',
          'ls_customer_id',
          'ls_status',
          'ls_renews_at',
          'ls_customer_portal_url',
          'referred_by'
        ];
      }

      function touchesServerOwnedFields() {
        return request.resource.data.diff(resource.data)
                 .affectedKeys()
                 .hasAny(serverOwnedFields());
      }

      allow read: if request.auth != null && request.auth.uid == userId;

      // Signup. The doc must start as a clean trial with its counters at zero,
      // so a crafted create can't mint a Pro account or a pre-spent trial.
      // `referred_by` may be set here (it's captured from the landing page at
      // signup) but becomes immutable immediately afterwards via the update
      // rule below.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.plan == 'trial'
                    && request.resource.data.api_queries_this_month == 0
                    && request.resource.data.trial_scans_used == 0;

      // Profile edits only — display name, email, preferences. Any attempt to
      // move the entitlement fields is rejected outright rather than silently
      // ignored, so a tampering attempt surfaces as a failed write.
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && !touchesServerOwnedFields();

      // No client-side delete. Deleting the profile and letting `ensureUserDoc`
      // recreate it would reset `trial_scans_used` and hand out a fresh set of
      // free scans on the same account. Account deletion is a support request
      // serviced by the Admin SDK (see the Privacy Policy's 30-day window).
      allow delete: if false;
    }

    // -------------------------------------------------------------------
    // Job documents. Owner is identified by the `userId` field on the doc.
    // Each verb is spelled out explicitly so the intent (and especially the
    // delete path used by the Dashboard trash button) is unambiguous.
    // -------------------------------------------------------------------
    match /jobs/{jobId} {
      // Owners may read their own job documents.
      allow read: if isExistingOwner();

      // Owners may create new jobs, but the new doc must already carry
      // their UID — otherwise an owner could plant a job under someone
      // else's account.
      allow create: if writesAsOwner();

      // Owners may update their own jobs. The UID cannot be re-assigned to
      // someone else as part of the same update.
      allow update: if isExistingOwner() && writesAsOwner();

      // Owners may delete their own jobs. This is the rule the Dashboard
      // trash button needs: `resource.data.userId == request.auth.uid`.
      allow delete: if isExistingOwner();
    }

    // -------------------------------------------------------------------
    // Referral ledger. Written exclusively by n8n's billing workflow when a
    // subscription is created or renewed; commission is calculated from it.
    // No client may read or write it — a referrer seeing another referrer's
    // conversions, or editing their own, is not something to leave to trust.
    // -------------------------------------------------------------------
    match /referrals/{referralId} {
      allow read, write: if false;
    }

    // Deny by default. Every other path is locked down.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
